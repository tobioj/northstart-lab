# Northstar Lab - sanitized configuration example. NO SECRETS belong in this file.
# Generate a filled-in version with:  npm run plan -- --root-domain <ROOT_DOMAIN> --environment staging
#
# Disabled by default. Every request returns 503 until this is exactly "true".
NORTHSTAR_ENABLED=false
# Free-form environment label shown on pages (e.g. staging, preview). "production" is refused.
NORTHSTAR_ENVIRONMENT=
NORTHSTAR_ROOT_DOMAIN=
# The three role origins: the ONLY hostname authority. https only. Nothing is derived; a
# missing origin fails closed. Unknown Host values get 421.
NORTHSTAR_PARENT_ORIGIN=
NORTHSTAR_WIDGET_ORIGIN=
NORTHSTAR_VERIFY_ORIGIN=
# Scenario token lifetime in seconds (60-86400, default 900).
NORTHSTAR_TOKEN_TTL=900
# Comma-separated hosts that must never be served (apex and www are always refused).
NORTHSTAR_PRODUCTION_HOSTS=
# Where local evidence is written (local scripts / Node adapter only; serverless handlers never write files).
NORTHSTAR_EVIDENCE_DIRECTORY=evidence
# Opt-in real hCaptcha/reCAPTCHA widgets on lanes 10/11 (contacts those providers). Default false.
NORTHSTAR_REAL_WIDGETS=false
NORTHSTAR_HCAPTCHA_SITE_KEY=
NORTHSTAR_RECAPTCHA_SITE_KEY=
#
# SECRETS - set ONLY in the hosting platform's secret manager, never in this file or in chat:
#   NORTHSTAR_TOKEN_SIGNING_KEY     required outside local/test; >= 32 random characters
#   NORTHSTAR_MANAGEMENT_AUTHORITY  optional bearer credential for /api/manage/*; unset = disabled
#
# REMOVED (deprecated, ignored if present): NORTHSTAR_CONTROL_HOST, NORTHSTAR_LANE_01_HOST ...
# NORTHSTAR_LANE_11_HOST, NORTHSTAR_ALLOWED_ORIGINS.
