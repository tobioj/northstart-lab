# Northstar Lab - sanitized configuration example. NO SECRETS belong in this file.
# Generate a filled-in version with:  npm run plan -- --root-domain <ROOT_DOMAIN> --environment staging
#
# Disabled by default. Every request returns 503 until this is exactly "true".
NORTHSTAR_ENABLED=false
# Free-form environment label shown on pages (e.g. staging, preview). "production" is refused.
NORTHSTAR_ENVIRONMENT=
NORTHSTAR_ROOT_DOMAIN=
# Each host is required. Nothing is derived automatically; a missing host fails closed.
NORTHSTAR_CONTROL_HOST=
NORTHSTAR_LANE_01_HOST=
NORTHSTAR_LANE_02_HOST=
NORTHSTAR_LANE_03_HOST=
NORTHSTAR_LANE_04_HOST=
NORTHSTAR_LANE_05_HOST=
NORTHSTAR_LANE_06_HOST=
NORTHSTAR_LANE_07_HOST=
NORTHSTAR_LANE_08_HOST=
NORTHSTAR_LANE_09_HOST=
NORTHSTAR_LANE_10_HOST=
NORTHSTAR_LANE_11_HOST=
# PUBLIC site keys only (they appear in page HTML by design).
NORTHSTAR_HCAPTCHA_SITE_KEY=
NORTHSTAR_RECAPTCHA_SITE_KEY=
# Comma-separated origins allowed to make CORS requests (no wildcards). Empty = none.
NORTHSTAR_ALLOWED_ORIGINS=
# Comma-separated hosts that must never be served as a lane (apex and www are always refused).
NORTHSTAR_PRODUCTION_HOSTS=
# Where local evidence is written (local scripts only; the deployed handler never writes files).
NORTHSTAR_EVIDENCE_DIRECTORY=evidence
#
# Private verification secrets (hCaptcha secret, reCAPTCHA secret) are NOT read by this
# project. If you store them, keep them only in the hosting platform's secret manager.
