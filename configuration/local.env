# Northstar Lab - LOCAL development values. Contains no secrets.
# Three role origins are the only hostname authority (no per-lane hostnames).
# The token signing key is ephemeral locally (generated per process); management is disabled
# unless NORTHSTAR_MANAGEMENT_AUTHORITY is set (tests set a random one at runtime).
NORTHSTAR_ENABLED=true
NORTHSTAR_ENVIRONMENT=local
NORTHSTAR_ROOT_DOMAIN=challenge.localhost
NORTHSTAR_PARENT_ORIGIN=http://parent.challenge.localhost:8787
NORTHSTAR_WIDGET_ORIGIN=http://widget.challenge.localhost:8787
NORTHSTAR_VERIFY_ORIGIN=http://verify.challenge.localhost:8787
NORTHSTAR_TOKEN_TTL=900
NORTHSTAR_PRODUCTION_HOSTS=
NORTHSTAR_EVIDENCE_DIRECTORY=evidence
NORTHSTAR_REAL_WIDGETS=false
# Published provider TEST site keys; only used if NORTHSTAR_REAL_WIDGETS=true.
NORTHSTAR_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
NORTHSTAR_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NORTHSTAR_PORT=8787
